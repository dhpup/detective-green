{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "pre-commit": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images in versions.env marked with a renovate comment",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z0-9_]+=\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group control-plane bumps so they're tested together",
      "matchFileNames": ["versions.env"],
      "groupName": "platform versions"
    }
  ]
}
