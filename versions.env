# Every pinned version and digest in one place. Scripts source this file;
# nothing else hard-codes a version. Renovate opens PRs to bump these.
#
# Charts are pinned by version AND the sha256 of the chart archive, and every
# image is pinned by digest. Renovate bumps the lines marked "renovate:"; chart
# versions and cert-manager digests are bumped by hand (`make pins` prints the
# new values). Run `make verify-pins verify-images` after changing anything.

# --- Local tooling (checked by `make doctor`, not installed by us)
K3D_VERSION=v5.9.0

# --- Cluster nodes
# renovate: datasource=docker depName=rancher/k3s
K3S_IMAGE=rancher/k3s:v1.36.4-k3s1@sha256:edad48e12bf81c3a09ac1c05c0c0ffaaa22145980b989d6fae84543a76b83657

# --- CNI (workload clusters). The chart already pins its own images by digest.
CILIUM_CHART_REPO=https://helm.cilium.io
CILIUM_CHART_VERSION=1.20.2
CILIUM_CHART_SHA256=b2afd87b7f75f875f92a14559f14f59b7babbb479d968e3fd625a20bf30ec20e

# --- Control plane (mgmt cluster)
CERT_MANAGER_CHART_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.2
CERT_MANAGER_CHART_SHA256=73a56e1728edd6c99f1f31082618c3259d279a76b7ebd3d4bdc5475c2442d34a
CERT_MANAGER_CONTROLLER_DIGEST=sha256:70f532fd9cfde0b09d55687200942399d89838bc2d5d5b45152eb799a15912b8
CERT_MANAGER_WEBHOOK_DIGEST=sha256:a60e2dac46dbb8a7f3df95c54ce941012f54c2fe022f0ee55aaa1ab40ed957ae
CERT_MANAGER_CAINJECTOR_DIGEST=sha256:c85268c64f2e0e76684bf5fe8906caff34b82523561c6affe0fae3546bd87562
CERT_MANAGER_STARTUPAPICHECK_DIGEST=sha256:46e75b6866359ffb5d82624f41e3ed1c70b2994982702ced547ce5edb418a8f5

ARGOCD_CHART_REPO=https://argoproj.github.io/argo-helm
ARGOCD_CHART_VERSION=10.9.2
ARGOCD_CHART_SHA256=970ced346a0ddc3e475a7ff780e9b9c2fdebc07d9a367d2edb6ef4f49832c24a
# renovate: datasource=docker depName=quay.io/argoproj/argocd
ARGOCD_IMAGE=quay.io/argoproj/argocd:v3.5.3@sha256:dd3f47d5a5e4da563a7a398506e892481b358a7cec50abdf320c71aa55904bfa
# renovate: datasource=docker depName=public.ecr.aws/docker/library/redis
ARGOCD_REDIS_IMAGE=public.ecr.aws/docker/library/redis:8.6.4-alpine@sha256:2cc044fc5a07c9b701f8f1255a309ae9ad7856e694ac03513bf3648c01e40763

ROLLOUTS_CHART_REPO=https://argoproj.github.io/argo-helm
ROLLOUTS_CHART_VERSION=2.43.2
ROLLOUTS_CHART_SHA256=35da227813ffce73445e88cc70e30f474c316db784fe9913d2bd94fd40706679
# renovate: datasource=docker depName=quay.io/argoproj/argo-rollouts
ROLLOUTS_IMAGE=quay.io/argoproj/argo-rollouts:v1.10.0@sha256:187630ba722846bb8e079630364d3c29c8246a256be95785fd957b088f621c4e

# Kargo's chart is an OCI artifact; hack/lib/oci.py fetches it and checks this digest.
KARGO_CHART_OCI=ghcr.io/akuity/kargo-charts/kargo
KARGO_CHART_VERSION=1.11.4
KARGO_CHART_SHA256=d655415d53a115101676e93f0489f7786f444155069fd3c199dccda1c77edf06
# renovate: datasource=docker depName=ghcr.io/akuity/kargo
KARGO_IMAGE=ghcr.io/akuity/kargo:v1.11.4@sha256:1413bdb63b1ad409c0a38a0ae5d6f4080e1fd3226aaf8344dfe0e5552921f533

# --- Base images for the images we build (src/*/Dockerfile must match)
# renovate: datasource=docker depName=golang
GO_BUILD_IMAGE=golang:1.27@sha256:3680233e3204827fbdc66088528ae6d4b3d034f51d03a99d454f6de034888244
# renovate: datasource=docker depName=gcr.io/distroless/static-debian12
DISTROLESS_STATIC_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
# renovate: datasource=docker depName=alpine
ALPINE_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

# --- CI tooling images (used by .github/workflows and hack/)
# renovate: datasource=docker depName=aquasec/trivy
TRIVY_IMAGE=aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969
# renovate: datasource=docker depName=golangci/golangci-lint
GOLANGCI_LINT_IMAGE=golangci/golangci-lint:v2.14.0@sha256:ad862ba6b3798cbe0fd9fd7408d498fd74fbd2623a92406b2fd3898faf0bf98f
GOVULNCHECK_VERSION=v1.8.0
# Go-installed tools, run in GO_BUILD_IMAGE with `go run <module>@<version>`
# (the Go checksum database verifies them; native on arm64 and amd64).
KUBECONFORM_VERSION=v0.8.0
KUSTOMIZE_VERSION=v5.8.1
# JSON schemas for CRDs (Argo CD, Argo Rollouts, Kargo, Prometheus operator), pinned to a commit.
CRDS_CATALOG_REF=ad3b08c5045129d7bb1eeffd8e61719b2c8dd1e2

# --- Observability (deployed by Argo CD from apps/observability). The version
# must match apps/observability/argocd/appset.yaml; image digests live in
# apps/observability/values.yaml. hack/verify-pins.sh checks both.
KUBE_PROMETHEUS_STACK_CHART_REPO=https://prometheus-community.github.io/helm-charts
KUBE_PROMETHEUS_STACK_CHART_VERSION=91.5.2
KUBE_PROMETHEUS_STACK_CHART_SHA256=3e4149116054b2ca0f94f97cfcd703f3d5f780fd6cd94e9c732881826a3ce5cf
